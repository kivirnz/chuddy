# Chuddy v2 - Environment variables
# All config is in config.yml. These are just runtime settings.

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Download settings
MAX_DOWNLOAD_THREADS=4
DOWNLOAD_TIMEOUT_SECONDS=300

# Post-processing
THUMBNAIL_FRAME_SECOND=1.0
INSTAGRAM_ENCODE_TO_H264=true
FACEBOOK_ENCODE_TO_H264=true

# Telegram limits
TG_MAX_MSG_SIZE=4096
TG_MAX_CAPTION_SIZE=1024

# STFU mode error sticker ID (optional)
# STFU_STICKER_ID=
